# Copy to .env and fill in values. Never commit real credentials.

# --- DuckDB (default warehouse profile; free + offline) ---
DUCKDB_PATH=data/warehouse.duckdb

# --- Snowflake (used when profile="snowflake") ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# --- S3 / MinIO ---
# For local MinIO keep these values. For real AWS S3, clear S3_ENDPOINT_URL
# (boto3 will then use the standard credential chain: env vars,
# ~/.aws/credentials, or an IAM role) and set the keys to your AWS creds.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RAW_BUCKET=raw-landing

# Host ports for the local MinIO stack (override if 9000/9001 are taken;
# update S3_ENDPOINT_URL to match).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
